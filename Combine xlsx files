import glob
import os
import pandas as pd

# Find all xlsx files in the specified folder
path = 'BCCIP/'  # Update this to your directory
all_files = glob.glob(os.path.join(path, "*.xlsx"))  # Changed from "." to path variable

# Check if any files were found before proceeding
if not all_files:
    print(f"No .xlsx files found in {path}")
else:
    print(f"Found {len(all_files)} .xlsx files")
    
    # Read and combine each file into a list, then concatenate
    df_list = [pd.read_excel(f) for f in all_files]
    combined_df = pd.concat(df_list, ignore_index=True)
    
    # Save the result to a new file
    combined_df.to_excel("combined_BCCIP.xlsx", index=False)
    print("Files successfully combined and saved!")
